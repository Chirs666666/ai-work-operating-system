{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gaps": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "competitor": {
            "type": "string"
          },
          "gap": {
            "type": "string"
          },
          "relevance": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              "UNKNOWN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "competitor",
          "gap",
          "relevance",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "gaps"
  ],
  "additionalProperties": false
}