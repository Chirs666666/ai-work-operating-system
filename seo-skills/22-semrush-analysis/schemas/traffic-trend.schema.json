{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "metric": {
      "const": "SEMRUSH_ESTIMATED_TRAFFIC"
    },
    "previous_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "current_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "previous_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "database": {
      "type": "string"
    },
    "device": {
      "type": [
        "string",
        "null"
      ]
    },
    "comparable": {
      "type": "boolean"
    },
    "trend": {
      "enum": [
        "UP",
        "DOWN",
        "STABLE",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "metric",
    "previous_value",
    "current_value",
    "previous_snapshot",
    "current_snapshot",
    "database",
    "device",
    "comparable",
    "trend"
  ],
  "additionalProperties": false
}