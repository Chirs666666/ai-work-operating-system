        "type": "object",
        "properties": {
          "keyword": {
            "type": "string"
          },
          "semrush_intent": {
            "type": [
              "string",
              "null"
            ]
          },
          "page_intent": {
            "type": [
              "string",
              "null"
            ]
          },
          "alignment": {
            "enum": [
              "ALIGNED",
              "PARTIAL",
              "MISALIGNED",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "keyword",
          "semrush_intent",
          "page_intent",
          "alignment"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}