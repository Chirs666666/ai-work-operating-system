{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formulas": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "formula_id": {
            "type": "string"
          },
          "formula_state": {
            "enum": [
              "VERIFIED",
              "CONDITIONALLY_VERIFIED",
              "CONFLICTING",
              "UNSUPPORTED",
              "UNKNOWN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflict_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "production_allowed": {
            "type": "boolean"
          }
        },
        "required": [
          "formula_id",
          "formula_state",
          "evidence_refs",
          "conflict_notes",
          "production_allowed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formulas"
  ],
  "additionalProperties": false
}