{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "included_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "minimum": {
            "type": [
              "number",
              "null"
            ]
          },
          "maximum": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "VERIFIED",
              "CONDITIONALLY_VERIFIED",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "assumptions",
    "included_effects",
    "excluded_effects",
    "boundaries"
  ],
  "additionalProperties": false
}