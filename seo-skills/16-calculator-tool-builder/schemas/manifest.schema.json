{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "skill": {
      "const": "16-calculator-tool-builder"
    },
    "version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": [
        "OPPORTUNITY_ASSESSMENT",
        "FORMULA_DESIGN",
        "BUILD_SPEC",
        "VALIDATE",
        "REFRESH",
        "VERIFY",
        "REUSE"
      ]
    },
    "source_methods": {
      "type": "array",
      "items": {
        "enum": [
          "USER_DATA",
          "API_DATA",
          "PUBLIC_RESEARCH"
        ]
      }
    }
  },
  "required": [
    "skill",
    "version",
    "mode",
    "source_methods"
  ],
  "additionalProperties": false
}