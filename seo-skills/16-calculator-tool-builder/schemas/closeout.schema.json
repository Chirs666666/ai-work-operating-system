{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "OPPORTUNITY_ASSESSMENT",
        "FORMULA_DESIGN",
        "BUILD_SPEC",
        "VALIDATE",
        "REFRESH",
        "VERIFY",
        "REUSE"
      ]
    },
    "g16": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCK",
        "REUSE",
        "WAITING_APPROVAL"
      ]
    },
    "final_status": {
      "enum": [
        "DONE",
        "PARTIAL",
        "BLOCKED",
        "REUSE",
        "WAITING_APPROVAL"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "mode",
    "g16",
    "final_status",
    "warnings",
    "blockers"
  ],
  "additionalProperties": false
}