{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "relationships"
  ],
  "properties": {
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_url",
          "target_url",
          "type"
        ],
        "properties": {
          "source_url": {
            "type": "string"
          },
          "target_url": {
            "type": "string"
          },
          "type": {
            "enum": [
              "PARENT_CHILD",
              "TOPIC_SUPPORT",
              "COMMERCIAL_SUPPORT",
              "APPLICATION_RELATION",
              "PROOF_SUPPORT",
              "DEEPER_LEARNING",
              "CONVERSION_PATH",
              "RELATED_CONTENT",
              "SIBLING_COMPARISON"
            ]
          },
          "evidence_state": {
            "enum": [
              "VERIFIED",
              "OBSERVED",
              "INFERRED",
              "UNKNOWN",
              "CONFLICTING"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
