{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sections": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "section_id": {
            "type": "string"
          },
          "action": {
            "enum": [
              "KEEP",
              "MINOR_EDIT",
              "REWRITE_SECTION",
              "ADD_SECTION",
              "MOVE_SECTION",
              "REMOVE_RECOMMENDATION"
            ]
          },
          "reason": {
            "type": "string"
          },
          "approval_required": {
            "type": "boolean"
          }
        },
        "required": [
          "section_id",
          "action",
          "reason",
          "approval_required"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sections"
  ],
  "additionalProperties": false
}