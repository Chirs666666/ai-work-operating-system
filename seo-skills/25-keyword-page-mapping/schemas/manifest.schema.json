{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "skill",
    "version",
    "mode"
  ],
  "properties": {
    "skill": {
      "const": "25-keyword-page-mapping"
    },
    "mode": {
      "enum": [
        "NEW_SITE",
        "EXISTING_SITE",
        "HYBRID"
      ]
    },
    "source_methods": {
      "type": "array",
      "items": {
        "enum": [
          "USER_DATA",
          "API_DATA",
          "PUBLIC_RESEARCH"
        ]
      }
    }
  },
  "additionalProperties": true
}