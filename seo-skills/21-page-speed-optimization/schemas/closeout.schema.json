{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "PERFORMANCE_AUDIT",
        "CWV_BASELINE",
        "LCP_DIAGNOSIS",
        "INP_DIAGNOSIS",
        "CLS_DIAGNOSIS",
        "TTFB_DIAGNOSIS",
        "IMAGE_AUDIT",
        "JS_AUDIT",
        "CSS_AUDIT",
        "FONT_AUDIT",
        "CACHE_AUDIT",
        "THIRD_PARTY_AUDIT",
        "OPTIMIZATION_PLAN",
        "PRE_CHANGE_CHECK",
        "POST_CHANGE_RETEST",
        "BEFORE_AFTER_COMPARE",
        "REFRESH",
        "VERIFY",
        "REUSE"
      ]
    },
    "g21": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCK",
        "REUSE",
        "WAITING_APPROVAL"
      ]
    },
    "final_status": {
      "enum": [
        "DONE",
        "PARTIAL",
        "BLOCKED",
        "REUSE",
        "WAITING_APPROVAL"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "mode",
    "g21",
    "final_status",
    "warnings",
    "blockers"
  ],
  "additionalProperties": false
}