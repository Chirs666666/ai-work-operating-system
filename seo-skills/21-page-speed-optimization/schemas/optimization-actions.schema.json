{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "expected_effect": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "live_change": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PROPOSED",
              "WAITING_APPROVAL",
              "APPROVED",
              "APPLIED",
              "REJECTED"
            ]
          }
        },
        "required": [
          "action",
          "target",
          "expected_effect",
          "risk",
          "live_change",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "actions"
  ],
  "additionalProperties": false
}