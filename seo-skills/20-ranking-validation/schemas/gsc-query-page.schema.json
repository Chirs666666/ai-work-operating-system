{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data_available": {
      "type": "boolean"
    },
    "url": {
      "type": "string"
    },
    "date_range": {
      "type": [
        "string",
        "null"
      ]
    },
    "market": {
      "type": [
        "string",
        "null"
      ]
    },
    "device": {
      "type": [
        "string",
        "null"
      ]
    },
    "queries": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "impressions": {
            "type": [
              "number",
              "null"
            ]
          },
          "clicks": {
            "type": [
              "number",
              "null"
            ]
          },
          "ctr": {
            "type": [
              "number",
              "null"
            ]
          },
          "average_position": {
            "type": [
              "number",
              "null"
            ]
          },
          "match_class": {
            "enum": [
              "TARGET_MATCH",
              "SEMANTIC_MATCH",
              "RELATED_QUERY",
              "UNRELATED_QUERY",
              "BRAND_QUERY",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "query",
          "impressions",
          "clicks",
          "ctr",
          "average_position",
          "match_class"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "data_available",
    "url",
    "date_range",
    "market",
    "device",
    "queries"
  ],
  "additionalProperties": false
}