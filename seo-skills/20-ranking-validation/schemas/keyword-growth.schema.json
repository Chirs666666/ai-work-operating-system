{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "keywords": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string"
          },
          "first_seen": {
            "type": [
              "string",
              "null"
            ]
          },
          "latest_position": {
            "type": [
              "number",
              "null"
            ]
          },
          "provider": {
            "type": "string"
          },
          "match_class": {
            "enum": [
              "TARGET_MATCH",
              "SEMANTIC_MATCH",
              "RELATED_QUERY",
              "UNRELATED_QUERY",
              "BRAND_QUERY",
              "UNKNOWN"
            ]
          },
          "trend": {
            "enum": [
              "NEW",
              "IMPROVING",
              "STABLE",
              "DECLINING",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "keyword",
          "first_seen",
          "latest_position",
          "provider",
          "match_class",
          "trend"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "keywords"
  ],
  "additionalProperties": false
}