{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "observations": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "provider": {
            "enum": [
              "GSC",
              "SEMRUSH",
              "AHREFS",
              "DATAFORSEO",
              "GOOGLE_SERP",
              "OTHER"
            ]
          },
          "metric": {
            "enum": [
              "AVERAGE_POSITION",
              "RANK_POSITION",
              "SERP_POSITION"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "date_range": {
            "type": [
              "string",
              "null"
            ]
          },
          "market": {
            "type": [
              "string",
              "null"
            ]
          },
          "device": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "provider",
          "metric",
          "value",
          "date_range"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "observations"
  ],
  "additionalProperties": false
}