{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "keywords": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string"
          },
          "provider": {
            "enum": [
              "SEMRUSH",
              "AHREFS",
              "DATAFORSEO",
              "GOOGLE_SERP",
              "OTHER"
            ]
          },
          "position": {
            "type": [
              "number",
              "null"
            ]
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "match_class": {
            "enum": [
              "TARGET_MATCH",
              "SEMANTIC_MATCH",
              "RELATED_QUERY",
              "UNRELATED_QUERY",
              "BRAND_QUERY",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "keyword",
          "provider",
          "position",
          "date",
          "match_class"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "keywords"
  ],
  "additionalProperties": false
}