{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target_intent": {
      "type": "string"
    },
    "observed_query_intent": {
      "type": "string"
    },
    "serp_intent": {
      "type": "string"
    },
    "alignment": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "target_intent",
    "observed_query_intent",
    "serp_intent",
    "alignment",
    "reason"
  ],
  "additionalProperties": false
}