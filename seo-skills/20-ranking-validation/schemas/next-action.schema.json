      "enum": [
        "MONITOR",
        "RECHECK_INDEX",
        "REVIEW_OWNERSHIP",
        "OPTIMIZE_INFORMATIONAL",
        "OPTIMIZE_COMMERCIAL",
        "ADD_INTERNAL_LINKS",
        "REVIEW_AUTHORITY",
        "DEEP_ANALYSIS",
        "NO_ACTION",
        "UNKNOWN"
      ]
    },
    "route_skill": {
      "type": [
        "string",
