{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "$defs": {
    "mode": {
      "enum": [
        "GENERATE",
        "AUDIT_PAGE",
        "OPTIMIZE",
        "PERFORMANCE_DIAGNOSIS",
        "SITE_AUDIT",
        "VERIFY"
      ]
    },
    "g09": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCK",
        "REUSE",
        "WAITING_APPROVAL"
      ]
