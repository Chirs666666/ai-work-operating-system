      "const": "09-seo-metadata"
    },
    "version": {
      "const": "1.0.0"
    },
    "mode": {
      "enum": [
        "GENERATE",
        "AUDIT_PAGE",
        "OPTIMIZE",
        "PERFORMANCE_DIAGNOSIS",
