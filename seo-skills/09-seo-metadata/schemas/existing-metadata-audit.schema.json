{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "HEALTHY",
        "MISSING",
        "WEAK",
        "MISALIGNED",
        "DUPLICATE",
        "PERFORMANCE_OPPORTUNITY",
        "OWNERSHIP_CONFLICT",
        "INSUFFICIENT_DATA"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "issues"
  ],
  "additionalProperties": false
}