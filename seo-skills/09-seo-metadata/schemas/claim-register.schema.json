{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "state": {
            "enum": [
              "SUPPORTED",
              "CONDITIONAL",
              "UNSUPPORTED",
              "CONFLICTING"
            ]
          },
          "qualifier": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "claim_id",
          "text",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "claims"
  ],
  "additionalProperties": false
}