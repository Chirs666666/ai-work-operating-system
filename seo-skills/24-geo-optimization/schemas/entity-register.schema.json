{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "COMPANY",
              "BRAND",
              "PRODUCT",
              "APPLICATION",
              "INDUSTRY",
              "TECHNOLOGY",
              "LOCATION",
              "OTHER"
            ]
          },
          "supported": {
            "type": "boolean"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "entity_id",
          "name",
          "type",
          "supported",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "entities"
  ],
  "additionalProperties": false
}