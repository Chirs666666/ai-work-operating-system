{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "page_purpose": {
      "type": "string"
    },
    "alignment": {
      "enum": [
        "ALIGNED",
        "PARTIAL",
        "MISALIGNED",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "topic",
    "intent",
    "page_purpose",
    "alignment"
  ],
  "additionalProperties": false
}