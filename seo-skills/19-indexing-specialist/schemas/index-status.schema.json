{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "UNKNOWN",
        "NOT_DISCOVERED",
        "DISCOVERED_NOT_CRAWLED",
        "CRAWLED_NOT_INDEXED",
        "INDEXED",
        "INDEXED_CANONICAL_OTHER",
        "BLOCKED_ROBOTS",
        "NOINDEX",
        "REDIRECTED",
        "SOFT_404",
        "DUPLICATE",
        "REMOVED",
        "ERROR"
      ]
    },
    "source_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "definitive": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "source_ref",
    "definitive",
    "notes"
  ],
  "additionalProperties": false
}