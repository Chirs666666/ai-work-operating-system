{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "route_skill": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "action",
          "route_skill",
          "priority",
          "blocking"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "actions"
  ],
  "additionalProperties": false
}