{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date_range": {
      "type": [
        "string",
        "null"
      ]
    },
    "market": {
      "type": [
        "string",
        "null"
      ]
    },
    "device": {
      "type": [
        "string",
        "null"
      ]
    },
    "queries": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "match_class": {
            "enum": [
              "TARGET_MATCH",
              "SEMANTIC_MATCH",
              "RELATED_QUERY",
              "UNRELATED_QUERY",
              "BRAND_QUERY",
              "UNKNOWN"
            ]
          },
          "impressions": {
            "type": [
              "number",
              "null"
            ]
          },
          "clicks": {
            "type": [
              "number",
              "null"
            ]
          },
          "position": {
            "type": [
              "number",
              "null"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "query",
          "match_class",
          "impressions",
          "clicks",
          "position",
          "source_ref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "date_range",
    "market",
    "device",
    "queries"
  ],
  "additionalProperties": false
}