  "type": "object",
  "properties": {
    "declared_canonical": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_canonical": {
      "type": [
        "string",
        "null"
      ]
    },
    "intended_canonical": {
      "type": "string"
