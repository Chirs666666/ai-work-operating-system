{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "in_sitemap": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "sitemap_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "internal_links_detected": {
      "type": [
        "integer",
        "null"
      ]
    },
    "discovery_status": {
      "enum": [
        "UNKNOWN",
        "NOT_DISCOVERED",
        "DISCOVERED"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "in_sitemap",
    "sitemap_url",
    "internal_links_detected",
    "discovery_status",
    "notes"
  ],
  "additionalProperties": false
}