{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "HEALTHY",
        "ISSUE",
        "UNKNOWN"
      ]
    },
    "diagnosis": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_route": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "diagnosis",
    "evidence_refs",
    "recommended_route"
  ],
  "additionalProperties": false
}