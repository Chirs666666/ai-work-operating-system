{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "target_query": {
            "type": "string"
          },
          "observed_matches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "best_match_class": {
            "enum": [
              "TARGET_MATCH",
              "SEMANTIC_MATCH",
              "RELATED_QUERY",
              "UNRELATED_QUERY",
              "BRAND_QUERY",
              "UNKNOWN"
            ]
          },
          "status": {
            "enum": [
              "DETECTED",
              "NOT_DETECTED",
              "NO_DATA"
            ]
          }
        },
        "required": [
          "target_query",
          "observed_matches",
          "best_match_class",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "targets"
  ],
  "additionalProperties": false
}