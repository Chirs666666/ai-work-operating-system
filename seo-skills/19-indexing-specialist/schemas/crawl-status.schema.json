      "enum": [
        "UNKNOWN",
        "NOT_DISCOVERED",
        "DISCOVERED_NOT_CRAWLED",
        "CRAWLED"
      ]
    },
    "last_crawl": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
