{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim-register",
  "type": "object",
  "required": [
    "claims"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "text",
          "source_ids",
          "confidence",
          "publishable"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "COMPANY_FACT",
              "EXTERNAL_FACT",
              "SUPPORTED_EXPLANATION",
              "EDITORIAL_JUDGMENT",
              "UNKNOWN"
            ]
          },
          "text": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              "UNKNOWN"
            ]
          },
          "publishable": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}