{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source-register",
  "type": "object",
  "required": [
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "method",
          "source_type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "method": {
            "enum": [
              "USER_DATA",
              "API_DATA",
              "PUBLIC_RESEARCH"
            ]
          },
          "source_type": {
            "type": "string"
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}