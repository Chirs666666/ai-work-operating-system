{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "$defs": {
    "mode": {
      "enum": [
        "FULL_INVENTORY",
        "URL_INVENTORY",
        "PERFORMANCE_ENRICHMENT",
        "ASSET_CLASSIFICATION",
        "ACTION_CLASSIFICATION",
        "REFRESH",
        "VERIFY"
      ]
    },
    "g15": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCK",
        "REUSE",
        "WAITING_APPROVAL"
      ]
