{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "action": {
            "enum": [
              "KEEP",
              "UPDATE",
              "REWRITE",
              "MERGE",
              "REDIRECT",
              "NOINDEX",
              "REMOVE",
              "REASSIGN",
              "HOLD"
            ]
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              "UNKNOWN"
            ]
          },
          "ownership_validation_required": {
            "type": "boolean"
          },
          "approval_required": {
            "type": "boolean"
          },
          "execution_allowed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "action",
          "confidence",
          "ownership_validation_required",
          "approval_required",
          "execution_allowed",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}