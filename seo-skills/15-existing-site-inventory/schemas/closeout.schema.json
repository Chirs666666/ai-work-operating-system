{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "FULL_INVENTORY",
        "URL_INVENTORY",
        "PERFORMANCE_ENRICHMENT",
        "ASSET_CLASSIFICATION",
        "ACTION_CLASSIFICATION",
        "REFRESH",
        "VERIFY"
      ]
    },
    "g15": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCK",
        "REUSE",
        "WAITING_APPROVAL"
      ]
    },
    "final_status": {
      "enum": [
        "DONE",
        "PARTIAL",
        "BLOCKED",
        "REUSE",
        "WAITING_APPROVAL"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "mode",
    "g15",
    "final_status",
    "warnings",
    "blockers"
  ],
  "additionalProperties": false
}