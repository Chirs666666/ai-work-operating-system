      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCK",
        "UNKNOWN"
      ]
    },
    "product_geometry": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "technical_labels": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "evidence_alignment": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "notes": {
