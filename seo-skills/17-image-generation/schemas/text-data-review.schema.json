{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCK",
        "UNKNOWN"
      ]
    },
    "text_present": {
      "type": "boolean"
    },
    "technical_data_present": {
      "type": "boolean"
    },
    "all_factual_text_evidence_backed": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "text_present",
    "technical_data_present",
    "all_factual_text_evidence_backed",
    "notes"
  ],
  "additionalProperties": false
}