{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "composition": {
      "type": "string"
    },
    "view_camera": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "material_finish": {
      "type": [
        "string",
        "null"
      ]
    },
    "allowed_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "text_data_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "truth_class": {
      "enum": [
        "SOURCE_PRESERVED",
        "SOURCE_DERIVED",
        "CONCEPTUAL",
        "VERIFIED_TECHNICAL",
        "UNKNOWN"
      ]
    },
    "width_px": {
      "type": "integer",
      "minimum": 1
    },
    "height_px": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "subject",
    "purpose",
    "composition",
    "allowed_changes",
    "prohibited_changes",
    "text_data_constraints",
    "truth_class",
    "width_px",
    "height_px"
  ],
  "additionalProperties": false
}