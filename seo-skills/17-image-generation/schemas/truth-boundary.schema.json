{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "truth_class": {
      "enum": [
        "SOURCE_PRESERVED",
        "SOURCE_DERIVED",
        "CONCEPTUAL",
        "VERIFIED_TECHNICAL",
        "UNKNOWN"
      ]
    },
    "documentary_evidence_claimed": {
      "type": "boolean"
    },
    "factual_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conceptual_disclosure_required": {
      "type": "boolean"
    }
  },
  "required": [
    "truth_class",
    "documentary_evidence_claimed",
    "factual_constraints",
    "conceptual_disclosure_required"
  ],
  "additionalProperties": false
}