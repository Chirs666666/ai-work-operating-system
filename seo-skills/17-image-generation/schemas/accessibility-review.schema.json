{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meaningful_image": {
      "type": "boolean"
    },
    "alt_required": {
      "type": "boolean"
    },
    "alt_redundant_with_adjacent_text": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "meaningful_image",
    "alt_required",
    "alt_redundant_with_adjacent_text",
    "status",
    "notes"
  ],
  "additionalProperties": false
}