{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "clicks": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "impressions": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "sessions": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "conversions": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "change_class": {
            "enum": [
              "GROWTH",
              "DECLINE",
              "MIXED",
              "STABLE",
              "INSUFFICIENT_DATA",
              "CONFLICTING_DATA"
            ]
          }
        },
        "required": [
          "url",
          "clicks",
          "impressions",
          "sessions",
          "conversions",
          "change_class"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "pages"
  ],
  "additionalProperties": false
}