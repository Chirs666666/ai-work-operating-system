{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "change_class": {
      "enum": [
        "GROWTH",
        "DECLINE",
        "MIXED",
        "STABLE",
        "INSUFFICIENT_DATA",
        "CONFLICTING_DATA"
      ]
    },
    "clicks": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "impressions": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "sessions": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "conversions": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "change_class",
    "clicks",
    "impressions",
    "sessions",
    "conversions"
  ],
  "additionalProperties": false
}