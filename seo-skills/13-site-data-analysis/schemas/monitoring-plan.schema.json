{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "metric": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "cadence": {
            "enum": [
              "DAILY",
              "WEEKLY",
              "MONTHLY",
              "QUARTERLY",
              "AD_HOC"
            ]
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": "string"
          }
        },
        "required": [
          "metric",
          "source",
          "cadence",
          "owner"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}