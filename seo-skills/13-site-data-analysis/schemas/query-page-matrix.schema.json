{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "relationship": {
            "enum": [
              "EXPECTED",
              "WRONG_PAGE_SIGNAL",
              "CANNIBALIZATION_SIGNAL",
              "MULTI_INTENT_POSSIBLE",
              "UNKNOWN"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "query",
          "url",
          "relationship",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}