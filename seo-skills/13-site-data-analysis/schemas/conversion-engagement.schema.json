{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessions": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "engaged_sessions": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "engagement_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "conversions": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "tracking_status": {
      "enum": [
        "VERIFIED",
        "PARTIAL",
        "BROKEN",
        "UNKNOWN"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "sessions",
    "engaged_sessions",
    "engagement_rate",
    "conversions",
    "tracking_status"
  ],
  "additionalProperties": false
}