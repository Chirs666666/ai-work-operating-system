{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "diagnosis_id": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          },
          "potential_cause": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "CONFIRMED",
              "SUPPORTED",
              "PLAUSIBLE",
              "UNVERIFIED",
              "REJECTED"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "diagnosis_id",
          "observation",
          "potential_cause",
          "confidence",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}