{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "CONFIRMED",
        "SUSPECTED",
        "NOT_CONFIRMED",
        "UNKNOWN"
      ]
    },
    "intent_overlap": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "query_overlap": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "url_switching": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ownership_confirmed": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "intent_overlap",
    "query_overlap",
    "url_switching",
    "ownership_confirmed",
    "evidence_refs"
  ],
  "additionalProperties": false
}