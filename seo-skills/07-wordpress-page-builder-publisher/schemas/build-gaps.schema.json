{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "page_id",
    "gaps"
  ],
  "properties": {
    "page_id": {
      "type": "string"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gap_id",
          "category",
          "severity",
          "state",
          "description"
        ],
        "properties": {
          "gap_id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "state": {
            "enum": [
              "OPEN",
              "RESOLVED",
              "ACCEPTED_RISK"
            ]
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
