{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "page_id",
    "report_type",
    "items"
  ],
  "properties": {
    "page_id": {
      "type": "string"
    },
    "report_type": {
      "enum": [
        "METADATA",
        "INTERNAL_LINK",
        "ASSET"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "source_artifact",
          "requested_value",
          "persisted_value",
          "verified"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "source_artifact": {
            "type": "string"
          },
          "requested_value": {},
          "persisted_value": {},
          "verified": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
