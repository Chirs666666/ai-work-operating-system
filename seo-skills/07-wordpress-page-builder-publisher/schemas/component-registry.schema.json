{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "registry_scope",
    "components"
  ],
  "properties": {
    "registry_scope": {
      "enum": [
        "GLOBAL",
        "PROJECT"
      ]
    },
    "project_id": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "component_type",
          "state",
          "required_slots"
        ],
        "properties": {
          "component_id": {
            "type": "string"
          },
          "component_type": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "state": {
            "enum": [
              "VERIFIED",
              "AVAILABLE",
              "CUSTOM_REQUIRED",
              "DEPRECATED"
            ]
          },
          "required_slots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optional_slots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layout_constraints": {
            "type": "object"
          },
          "builder": {
            "enum": [
              "BLOCK_EDITOR",
              "ELEMENTOR",
              "ANY"
            ]
          },
          "engine": {
            "type": "string"
          },
          "implementation": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
