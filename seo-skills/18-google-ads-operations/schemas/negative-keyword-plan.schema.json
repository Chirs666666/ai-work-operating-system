{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "term": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "ACCOUNT",
              "CAMPAIGN",
              "AD_GROUP",
              "UNKNOWN"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "live_action_requested": {
            "type": "boolean"
          }
        },
        "required": [
          "term",
          "reason",
          "scope",
          "evidence",
          "live_action_requested"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "candidates"
  ],
  "additionalProperties": false
}