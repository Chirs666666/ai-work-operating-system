    "identity": {
      "type": "object"
    },
    "business_scope": {
      "type": "array"
    },
    "locations": {
      "type": "array"
    },
    "industries": {
      "type": "array"
    },
    "capabilities": {
      "type": "array"
    },
    "certifications": {
      "type": "array"
    },
    "facts": {
      "type": "array"
    }
  }
}