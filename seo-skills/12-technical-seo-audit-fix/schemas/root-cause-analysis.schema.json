{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "symptom": {
            "type": "string"
          },
          "probable_root_cause": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              "UNKNOWN"
            ]
          },
          "intended_state": {
            "type": "string"
          }
        },
        "required": [
          "issue_id",
          "symptom",
          "probable_root_cause",
          "confidence",
          "intended_state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}