              "WARNING",
              "BLOCKED",
              "UNKNOWN"
            ]
          },
          "handoff_to_08": {
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "crawlable_html_entry",
          "depth",
          "technical_state",
          "handoff_to_08"
        ],
        "additionalProperties": false
