{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "urls_crawled": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "issues_found": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "crawl_complete": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "urls_crawled",
    "issues_found",
    "crawl_complete",
    "notes"
  ],
  "additionalProperties": false
}