{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gate": {
      "type": "string",
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCK",
        "REUSE",
        "WAITING_APPROVAL"
      ]
    },
    "architecture_state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATED",
        "CONFLICT",
        "BLOCKED",
        "REUSE",
        "READY_FOR_BUILD"
      ]
    },
    "ready_for_build": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "gate",
    "architecture_state",
    "ready_for_build",
    "warnings",
    "blockers",
    "next_skills"
  ],
  "additionalProperties": false
}