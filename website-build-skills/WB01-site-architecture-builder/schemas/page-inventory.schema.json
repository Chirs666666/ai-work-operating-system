              "EXISTING",
              "RETAIN",
              "NEW",
              "REVIEW",
              "BLOCKED"
            ]
          }
        },
        "required": [
          "page_id",
          "title",
          "family_id",
          "page_type",
          "parent_page_id",
          "root",
          "proposed_url",
          "existing_live_url",
          "primary_intent",
          "ownership_source",
          "ownership_key",
          "differentiation_rationale",
          "navigation_visibility",
          "status"
