        "type": "object",
        "properties": {
          "page_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "family_id": {
            "type": "string"
          },
          "page_type": {
            "type": "string"
          },
          "parent_page_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "root": {
            "type": "boolean"
          },
          "proposed_url": {
            "type": "string"
          },
          "existing_live_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "primary_intent": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownership_source": {
            "type": "string",
            "enum": [
              "SKILL_25",
              "USER",
              "WB01_PROVISIONAL",
              "UNKNOWN"
            ]
          },
          "ownership_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "differentiation_rationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "navigation_visibility": {
            "type": "string",
            "enum": [
              "PRIMARY",
              "SECONDARY",
              "FOOTER",
              "UTILITY",
